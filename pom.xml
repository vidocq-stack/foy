    <scm>
        <connection>scm:git:https://codefloe.com/Vidocq/foy.git</connection>
        <developerConnection>scm:git:ssh://git@forge.vidocq.dev:vidocq/foy.git</developerConnection>
        <url>https://codefloe.com/Vidocq/foy</url>
    </scm>

    <properties>
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <chappe.version>0.4.0-SNAPSHOT</chappe.version>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>

        <!-- Quality (Vidocq/vidocq#269), as in Chappe -->
        <errorprone.version>2.50.0</errorprone.version>
        <japicmp.version>0.26.3</japicmp.version>
        <!-- The API compatibility report (quality profile) covers the modules that turn it on: foy-api,
             foy-chappe and foy-cdi-vauban, each with the packages its module-info.java exports. foy-core
             exports internal packages only, and foy-processor runs at build time. -->
        <japicmp.skip>true</japicmp.skip>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            foy-coverage (quality profile), so the tests of foy-it-weld, foy-it-weld-servlet and
            foy-it-vauban-session count for the code they exercise in the other modules.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/foy-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <!--
        foy-tck joins the reactor only under the `tck` profile (see <profiles>
        below) — TCK harmonisation, same pattern as the vidocq-runtime-tck-*
        runners and the dirac pilot: a plain `mvn install` neither downloads nor
        runs anything TCK-related. The historical out-of-reactor constraint
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0 POMs) disappeared with the
        Maven 3.9.16 / Model 4.0.0 migration.
    -->
    <modules>
        <module>foy-api</module>
        <module>foy-processor</module>
        <module>foy-core</module>
        <module>foy-cdi-vauban</module>
        <module>foy-chappe</module>
        <module>foy-it-other-containers</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta APIs -->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.servlet.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Chappe (transport HTTP par défaut, optionnel) -->
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-api</artifactId>
                <version>${chappe.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-core</artifactId>
                <version>${chappe.version}</version>
            </dependency>

            <!-- Vauban (compile scope pour foy-cdi-vauban) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Foy modules internes -->
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.foy</groupId>
                <artifactId>foy-chappe</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <!--
            TCK harmonisation: the official Jakarta Servlet 6.1 TCK runner joins
            the reactor only when this profile is active.

                ./mvnw -Ptck,tck-official -pl foy-tck test    # suite (see script for modes)

            run-official-tck-servlet6.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>foy-tck</module>
            </modules>
        </profile>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>foy-coverage</module>
            </modules>
            <build>
                <plugins>
                    <!-- API compatibility with the last release (Vidocq/vidocq#288), report mode: japicmp
                         compares each jar with the latest x.y.z release on Maven Central and writes
                         target/japicmp/; nothing breaks the build until 1.0.0-RC1 makes it a gate. -->
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <parameter>
                                <oldVersionPattern>\d+\.\d+\.\d+</oldVersionPattern>
                                <onlyModified>true</onlyModified>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            </parameter>
                            <skipDiffReport>true</skipDiffReport>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-compatibility</id>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Error Prone (Vidocq/vidocq#269): run locally with -Perrorprone, and by the SonarQube job, which
             imports its warnings as external issues. Report mode, like the rest of the analysis: every
             finding is a warning (-XepAllErrorsAsWarnings), none stops the build. Error Prone needs the
             javac internals .mvn/jvm.config opens. -->
        <profile>
            <id>errorprone</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <configuration>
                                <compilerArgs combine.children="append">
                                    <arg>-XDcompilePolicy=simple</arg>
                                    <arg>--should-stop=ifError=FLOW</arg>
                                    <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepExcludedPaths:.*(generated|generated-sources)/.* -XepDisableWarningsInGeneratedCode</arg>
                                </compilerArgs>
                                <annotationProcessorPaths combine.children="append">
                                    <path>
                                        <groupId>com.google.errorprone</groupId>
                                        <artifactId>error_prone_core</artifactId>
                                        <version>${errorprone.version}</version>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
