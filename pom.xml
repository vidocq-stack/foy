    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.foy</groupId>
    <artifactId>foy-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Foy</name>
    <description>Implémentation Jakarta Servlet 6.1 standalone — moteur Servlet pur, transport HTTP via SPI, CDI optionnel</description>
    <url>https://codefloe.com/Vidocq/foy</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

