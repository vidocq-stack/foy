<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.foy</groupId>
        <artifactId>foy-it-other-containers</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>foy-it-vauban-session</artifactId>
    <name>Foy :: Session scope on Vauban</name>
    <description>The session scenarios of foy-it-session-scenarios, run on Foy with Vauban: the session
        context comes from vauban-webcontexts, driven by foy-cdi-vauban (foy#21). The same scenarios
        pass on foy-it-weld-servlet, where Weld manages the session context.</description>

    <!-- Every dependency is test-scoped: the module ships nothing. -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-it-session-scenarios</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-cdi-vauban</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-chappe</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A class path, as foy-it-weld-servlet: the two runs differ only by the CDI container. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
