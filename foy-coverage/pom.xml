<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.foy</groupId>
        <artifactId>foy-parent</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <artifactId>foy-coverage</artifactId>
    <packaging>pom</packaging>

    <name>Foy :: Coverage</name>
    <description>Aggregated JaCoCo report of the reactor, read by SonarQube (quality profile only)</description>

    <properties>
        <!-- Quality-only module, listed by the quality profile of foy-parent: never released,
             installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        report-aggregate reads these dependencies: in compile scope, their classes, sources and
        execution data make up the report; in test scope, only their execution data counts.
        foy-it-weld, foy-it-weld-servlet and foy-it-vauban-session only hold tests of the other
        modules, so without this report they would not count for the code they exercise
        (Vidocq/vidocq#284). foy-it-session-scenarios is a test vehicle without tests of its
        own, left out of the analysis, and foy-tck only joins the reactor under the tck profile.
    -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-processor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-cdi-vauban</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-chappe</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-it-weld</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-it-weld-servlet</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-it-vauban-session</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
