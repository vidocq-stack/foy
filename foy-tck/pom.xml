<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of foy-parent
    (TCK harmonisation — same pattern as the vidocq-runtime-tck-* runners and
    the dirac pilot): a plain `mvn install` neither downloads nor runs anything
    TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration.

    Internal dependencies (foy-api, foy-core, foy-chappe, foy-cdi-vauban) are
    pinned to the reactor version installed in the local M2 repository — the
    foy.version property MUST follow reactor bumps, otherwise the TCK silently
    validates stale jars (same trap as cassini-tck).

    Le lancement passe par le script :
        ./run-official-tck-servlet6.1.sh                     (smoke test)
        ./run-official-tck-servlet6.1.sh all                 (suite complète ; option all en double-tiret)
        ./run-official-tck-servlet6.1.sh -Dtest=ServletTests (classe ciblée)

    Détails dans README.md de ce module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.foy</groupId>
        <artifactId>foy-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>foy-tck</artifactId>
    <packaging>jar</packaging>

    <name>Foy :: TCK Runner</name>
    <description>Harness de conformance Jakarta Servlet 6.1 et point d'entrée pour le TCK officiel</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <foy.version>0.4.0-SNAPSHOT</foy.version>
        <chappe.version>0.4.0-SNAPSHOT</chappe.version>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <servlet-api.version>6.1.0</servlet-api.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-api</artifactId>
            <version>${foy.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-core</artifactId>
            <version>${foy.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-chappe</artifactId>
            <version>${foy.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-cdi-vauban</artifactId>
            <version>${foy.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet-api.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.container</groupId>
            <artifactId>arquillian-container-spi</artifactId>
            <version>1.8.0.Final</version>
            <scope>test</scope>
        </dependency>
        <!-- Test tooling only (never shipped): the harness tests build WebArchives the way the
             official TCK does, so ShrinkWrap is on the default test classpath, not only under
             tck-official. -->
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>1.2.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>1.2.6</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-tck-workdir-pom</id>
                                <phase>process-test-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/tck-workdir</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/test/tck-resources</directory>
                                            <includes><include>pom.xml</include></includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- CLIENT-CERT (BUG-20261011-03): the TCK's client certificates. Build-time only. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-tck-certificates</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>unpack</goal></goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>jakarta.tck</groupId>
                                            <artifactId>servlet-tck-runtime</artifactId>
                                            <version>6.1.0</version>
                                        </artifactItem>
                                    </artifactItems>
                                    <includes>certificates/**</includes>
                                    <outputDirectory>${project.build.directory}/tck-certificates</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- CLIENT-CERT (BUG-20261011-03): the https container's key store (SAN 127.0.0.1 and
                             localhost), the client's trust store of it, and the server's trust store of the
                             TCK's cts_cert. Build-time only: the JDK's keytool, the <delete> keeps it idempotent. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>generate-tls-stores</id>
                                <phase>process-test-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <property name="tls.dir" value="${project.build.directory}/tls"/>
                                        <property name="keytool" value="${java.home}/bin/keytool"/>
                                        <delete dir="${tls.dir}"/>
                                        <mkdir dir="${tls.dir}"/>
                                        <exec executable="${keytool}" failonerror="true">
                                            <arg line="-genkeypair -alias foy-tck -keyalg RSA -keysize 2048 -validity 3650"/>
                                            <arg value="-dname"/><arg value="CN=localhost, O=Foy TCK"/>
                                            <arg value="-ext"/><arg value="SAN=ip:127.0.0.1,dns:localhost"/>
                                            <arg value="-keystore"/><arg value="${tls.dir}/server.p12"/>
                                            <arg line="-storetype PKCS12 -storepass changeit -keypass changeit"/>
                                        </exec>
                                        <exec executable="${keytool}" failonerror="true">
                                            <arg line="-exportcert -rfc -alias foy-tck"/>
                                            <arg value="-keystore"/><arg value="${tls.dir}/server.p12"/>
                                            <arg line="-storepass changeit"/>
                                            <arg value="-file"/><arg value="${tls.dir}/server.pem"/>
                                        </exec>
                                        <exec executable="${keytool}" failonerror="true">
                                            <arg line="-importcert -noprompt -alias foy-tck"/>
                                            <arg value="-file"/><arg value="${tls.dir}/server.pem"/>
                                            <arg value="-keystore"/><arg value="${tls.dir}/client-trust.p12"/>
                                            <arg line="-storetype PKCS12 -storepass changeit"/>
                                        </exec>
                                        <exec executable="${keytool}" failonerror="true">
                                            <arg line="-importcert -noprompt -alias cts"/>
                                            <arg value="-file"/><arg value="${project.build.directory}/tck-certificates/certificates/cts_cert"/>
                                            <arg value="-keystore"/><arg value="${tls.dir}/server-trust.p12"/>
                                            <arg line="-storetype PKCS12 -storepass changeit"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>jakarta.tck:servlet-tck-runtime</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Tests.class</include>
                            </includes>
                            <workingDirectory>${project.build.directory}/tck-workdir</workingDirectory>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <systemPropertyVariables>
                                <webServerHost>127.0.0.1</webServerHost>
                                <!-- Users of the security tests (TckIdentities). DenyUncoveredTests and
                                     MetaDataCompleteTests read them without defaults. -->
                                <user>j2ee</user>
                                <password>j2ee</password>
                                <authuser>javajoe</authuser>
                                <authpassword>javajoe</authpassword>
                                <!-- HTTP/2 server push is an accepted gap (no h2c Upgrade nor PUSH_PROMISE
                                     in chappe; push is deprecated in Servlet 6.1): the TCK's own switch
                                     skips the ServerPushTests that need it (7 of 8), reported as skipped. -->
                                <servlet.tck.support.http2Push>false</servlet.tck.support.http2Push>
                                <webServerPort>8080</webServerPort>
                                <ts_home>${project.build.directory}/test-classes</ts_home>
                                <!-- CLIENT-CERT (BUG-20261011-03): the TCK client presents the CTS certificate and trusts the
                                     build-generated server certificate; the https container serves with server.p12 and trusts cts_cert. -->
                                <javax.net.ssl.keyStore>${project.build.directory}/tck-certificates/certificates/clientcert.jks</javax.net.ssl.keyStore>
                                <javax.net.ssl.keyStorePassword>changeit</javax.net.ssl.keyStorePassword>
                                <javax.net.ssl.keyStoreType>JKS</javax.net.ssl.keyStoreType>
                                <javax.net.ssl.trustStore>${project.build.directory}/tls/client-trust.p12</javax.net.ssl.trustStore>
                                <javax.net.ssl.trustStorePassword>changeit</javax.net.ssl.trustStorePassword>
                                <javax.net.ssl.trustStoreType>PKCS12</javax.net.ssl.trustStoreType>
                                <foy.tck.tls.dir>${project.build.directory}/tls</foy.tck.tls.dir>
                            </systemPropertyVariables>
                            <!-- Certains tests TCK injectent Cookie/Host/etc. que
                                 Java HttpClient refuse par défaut (JDK-8203771).
                                 La propriété doit être passée en argLine car elle
                                 est lue au static init de jdk.internal.net.http. -->
                            <argLine>-Djdk.httpclient.allowRestrictedHeaders=host,connection,content-length,expect,upgrade,origin,date,via,cookie</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>servlet-tck-runtime</artifactId>
                    <version>6.1.0</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>servlet-tck-util</artifactId>
                    <version>6.1.0</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                    <version>2.0.16</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <version>2.0.16</version>
                    <scope>test</scope>
                </dependency>
                <!-- JUnit 4 requis par org.jboss.arquillian.junit.State (result tracker) -->
                <dependency>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                    <version>4.13.2</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- API signature test (the TCK's own ServletSigTest, signature file jakarta.servlet.sig_6.1)
                 of the jakarta.servlet-api jar Foy runs on. Combine with tck-official:
                 ./mvnw -ntp -Ptck,tck-official,sigtest -pl foy-tck test -Dtest=ServletSigTest
                        -Dsurefire.failIfNoSpecifiedTests=false
                 Build-time only: sigtest-maven-plugin (test scope) and maven-dependency-plugin. -->
            <id>sigtest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-servlet-api-for-sigtest</id>
                                <phase>process-test-resources</phase>
                                <goals><goal>copy</goal></goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>jakarta.servlet</groupId>
                                            <artifactId>jakarta.servlet-api</artifactId>
                                            <version>${servlet-api.version}</version>
                                            <destFileName>jakarta.servlet-api.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}/sigtest</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <jimage.dir>${project.build.directory}/jimage</jimage.dir>
                                <sigTestClasspath>${project.build.directory}/sigtest/jakarta.servlet-api.jar${path.separator}${project.build.directory}/jimage/java.base</sigTestClasspath>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>sigtest-maven-plugin</artifactId>
                    <version>2.5</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
