<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.foy</groupId>
        <artifactId>foy-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>foy-cdi-vauban</artifactId>
    <name>Foy :: CDI Vauban Adapter</name>
    <description>Adapter Vauban CDI pour Foy : implémente la SPI BeanProvider et expose les beans @WebServlet/@WebFilter/@WebListener du container Vauban.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-api</artifactId>
        </dependency>
        <!-- FoySessionContext (foy#21), named by FoyWebExtension's @Discovery. -->
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <!-- Test only: FoyWebExtensionTest compiles tiny apps in-process with vauban's annotation
             processor on the processor path (with this module's classes), then serves them
             through FoyChappeBoot. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-processor</artifactId>
            <version>${vauban.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.foy</groupId>
            <artifactId>foy-chappe</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Same set-up as cassini-cdi-vauban: vauban's annotation processor runs over
                         this module's own beans (none today; the build compatible extension and
                         the synthetic bean creator are not beans). -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans; FoyWebExtensionTest drives javac
                         in-process (javax.tools) and an HTTP client, which the main module does
                         not read. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.compiler,java.net.http</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.foy.cdi.vauban=java.compiler,java.net.http</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Keep the module path; only add the JDK modules the test reads, and chappe-api,
                         which foy-core (a compile dependency) puts on the module path while the
                         main module does not read it. -->
                    <argLine>--add-modules java.compiler,java.net.http --add-reads io.vidocq.foy.cdi.vauban=java.compiler,java.net.http,io.vidocq.chappe.api</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
